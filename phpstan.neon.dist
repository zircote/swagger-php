includes:
	- phpstan-baseline.neon

parameters:
    phpVersion: 80200
    # classic and docs/examples are analysed at level 5 by phpstan-level5.neon.dist
    level: 7
    paths:
        - src
        - tests
        - tools
        - rector
    scanDirectories:
        # snippets are transcluded into the docs and exercised by tests; known, not analysed
        - docs/snippets
        # the examples are analysed at level 5 by phpstan-level5.neon.dist; tests build them
        - docs/examples
    scanFiles:
        # global namespace on purpose, so not autoloadable and not discovered on its own
        - tests/Fixtures/PHP/GlobalNamespaceTypes.php
    parallel:
        processTimeout: 300.0
    excludePaths:
        - 'tests/Fixtures/*'
        - src/Annotations
        - src/Attributes
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            # the classic processors assign Generator::UNDEFINED to annotation properties
            message: '#Property OpenApi\\Annotations.*::\$.* does not accept string.#'
            identifier: assign.propertyType
